[user]
	email = G36_maid@proton.me
	name = G36maid
[core]
#	editor = zeditor --wait
[alias]
	graph = log --graph --oneline --all --decorate
[init]
	defaultBranch = main
[pull]
	rebase = true

# Host-specific settings (credential helpers, work-only identity, ...).
# The file is machine-local and NOT tracked or stowed — see
# .gitconfig.local.example in this repo. A missing file is silently ignored.
[include]
	path = ~/.gitconfig.local
