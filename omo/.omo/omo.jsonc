// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "models": [
          "zai-coding-plan/glm-5.2",
          { "model": "openai/gpt-5.6-luna", "reasoning": "max" },
          "opencode-go/glm-5.2"
        ]
      },
      "hephaestus": {
        "models": [
          "openai/gpt-5.6-sol"
        ]
      },
