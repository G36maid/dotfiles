# ===== Secrets (NEVER commit) =====
# GitHub CLI token
hosts.yml
# Zed API credentials
development_credentials
# Advent of Code session
*.session
# SSH / GPG / Docker / K8s
.ssh/
.gnupg/
.docker/
.kube/
.mcp-auth/
.npmrc
.claude.json
.codex/
.gemini/

# ===== Cache / runtime state =====
**/node_modules/
**/.cache/
**/cache/
*.log
error.log
**/cached_layouts

# ===== Backups =====
*.bak
*.backup
*.orig
*.swp
*~

# ===== App-specific runtime =====
# fcitx5 regenerates this
**/fcitx5/conf/cached_layouts
# btop rewrites its full state on theme/settings change (unstowed, real file in $HOME)
**/.config/btop/
# Qt apps persist geometry/state into QtProject.conf (unstowed, real file in $HOME)
**/QtProject.conf
# Zed backup
**/zed/settings_backup.json
# Opencode runtime artifacts
**/opencode/package-lock.json
**/opencode/*.backup-*
**/opencode/rate-limit-fallback.json.bak-*
# Opencode credential store — stowed under opencode/.local/share but NEVER committed (public repo)
**/.local/share/opencode/auth.json
/.playwright-cli/
# OMO harness runtime artifacts (until OMO is fully retired)
/.omo/
# pi agent: auth holds API keys; sessions are chat logs; bin holds downloaded helper binaries.
# Only .pi/agent/{settings,models,mcp}.json + prompts/ are tracked.
**/.pi/agent/auth.json
**/.pi/agent/sessions/
**/.pi/agent/bin/
# pi runtime state (package store, model/mcp caches, trust db, ACP dir) — safety net:
# these belong in the real ~/.pi, but if ~/.pi ever gets tree-folded into the repo
# (stow without --no-folding) this keeps them out of git.
**/.pi/agent/npm/
**/.pi/agent/models-store.json
**/.pi/agent/mcp-cache.json
**/.pi/agent/mcp-npx-cache.json
**/.pi/agent/trust.json
**/.pi/pi-acp/
# pi-web-access config — its schema takes provider API keys (jinaApiKey, openaiApiKey, …),
# so it's stowed but untracked, same policy as auth.json.
**/.pi/web-search.json
