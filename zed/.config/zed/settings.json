        "move_path": {
          "default": "allow",
        },
        "mcp:markitdown:convert_to_markdown": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b",
            },
            {
              "pattern": "^git\\s+diff(\\s|$)",
            },
            {
              "pattern": "^cd\\b",
            },
          ],
        },
      },
    },
