// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "prefer_line",
  "tab_size": 4,
  "languages": {
    "JSON": {
      "formatter": "prettier"
    },
    "JSONC": {
      "formatter": "prettier"
    }
  },
  "cli_default_open_behavior": "new_window",
  "minimap": {
    "show": "auto"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-4-neon"
      },
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode/glm-5.2"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "diff_view_style": "unified",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "Z.ai",
      "model": "glm-5.3-flash",
      "enable_thinking": false
    },
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "mcp:mcp-server-exa-search:web_search_exa": {
          "default": "allow"
        },
        "mcp:mcp-server-exa-search:web_fetch_exa": {
          "default": "allow"
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^/home/g36maid/School/ntu/ai\\-distributed\\-ml/hw1/"
            }
          ]
        },
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^lab02/"
            }
          ]
        },
        "move_path": {
          "default": "allow"
        },
        "mcp:markitdown:convert_to_markdown": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^git\\s+diff(\\s|$)"
            },
            {
              "pattern": "^cd\\b"
            }
          ]
        }
      }
    },
