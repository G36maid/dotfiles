{
  "plugin": [
    "opencode-mermaid-renderer@latest",
    "@azumag/opencode-rate-limit-fallback",
    "opencode-todo-enforcer",
    "opencode-tps-meter"
  ],
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3-flash",
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": "allow"
  },
  "providers": {
    "dgx-spark-x2": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "GLM-5.3-Flash",
      "settings": {
        "baseURL": "http://spark-037c:8888/v1"
      },
      "models": {
        "GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash-EXL3",
          // context/output: recipe README — CONTEXT_MAX 1048576, MAX_TOKENS 32768
          "limit": { "context": 1048576, "output": 32768 },
          "capabilities": {
            "reasoning": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "high", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "xhigh" } }
          ]
        }
      }
    }
  },
  // "lsp": {},
  "mcp": {
    "deepwiki": { "type": "remote", "url": "https://mcp.deepwiki.com/mcp" },
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" },
    "grep-app": { "type": "remote", "url": "https://mcp.grep.app" },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa"
    },
    "ghidra": {
      "type": "local",
      "enabled": false,
      "command": [
        "uv",
        "run",
        "--script",
        "/home/g36maid/Code/AI/ghidra-mcp/bridge_mcp_ghidra.py"
      ]
    }
  }
}
